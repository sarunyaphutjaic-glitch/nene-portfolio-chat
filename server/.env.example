# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
PORT=3001

# Postgres ในเครื่อง (docker compose) หรือ connection string ของ Neon/Render
DATABASE_URL=postgres://nene:nene@localhost:5432/nene_portfolio

# เลือก AI: gemini หรือ claude
AI_PROVIDER=gemini

# Gemini API key จาก aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Claude API key จาก console.anthropic.com (ใช้เมื่อ AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# true = ไม่เรียก AI จริง (ตอบแบบ echo) ใช้ตอนพัฒนา UI เพื่อประหยัดเครดิต
AI_MOCK=false

# URL ของ frontend ที่อนุญาต (คั่นด้วย , ได้หลายอัน) เว้นว่าง = อนุญาตทุกที่
CLIENT_URL=http://localhost:5173
